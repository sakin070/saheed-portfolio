---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { publishedPosts, formatDate, readingMinutes } from '../../lib/posts';
import { profile } from '../../data/profile';
export async function getStaticPaths() {
  return (await publishedPosts()).map(post => ({ params: { slug: post.id }, props: { post } }));
}
interface Props { post: CollectionEntry<'posts'>; }
const { post } = Astro.props;
const { Content } = await render(post);
---
<Layout title={`${post.data.title} — Saheed Akinbile`} description={post.data.description} article>
  <article class="container article">
    <a class="article-back" href="/writing/">← All writing</a>
    <header class="article-header"><p class="eyebrow">{post.data.category}</p><h1>{post.data.title}</h1><p class="article-deck">{post.data.description}</p><div class="article-byline"><div>Saheed Akinbile<span><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time> · {readingMinutes(post.body)} min read</span></div></div></header>
    <div class="prose"><Content /></div>
    <div class="article-end"><a href="/writing/">← Back to the notebook</a><a href={profile.linkedin} target="_blank" rel="noreferrer">Continue the conversation ↗</a></div>
  </article>
</Layout>
