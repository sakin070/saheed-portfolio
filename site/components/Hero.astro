---
import Arrow from './Arrow.astro';
import Star from './Star.astro';
---
<section class="hero container" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow hero-eyebrow"><span class="status-dot"></span> FOUNDER & ENGINEER · SAN FRANCISCO</p>
    <h1 id="hero-title">Building a<br />future we<br />can <em>own.</em><span class="sr-only"> — Saheed Akinbile</span></h1>
    <p class="hero-description">I’m <strong>Saheed Akinbile</strong>, co-founder & CTO of <a href="https://minicor.com/" target="_blank" rel="noreferrer">Minicor (YC)</a>. I build software, businesses, and a few things that grow. Rooted in Nigeria. Based in San Francisco.</p>
    <a class="text-link" href="#work">Explore my work <Arrow /></a>
  </div>
  <div class="hero-visual">
    <div class="portrait-topline"><span class="eyebrow">A LITTLE ABOUT ME</span><Star /></div>
    <figure class="portrait">
      <img src="/images/saheed.jpg" width="460" height="460" alt="Saheed Akinbile wearing an olive green shirt" fetchpriority="high" />
      <figcaption><span class="small-dot"></span> Many interests. One direction.</figcaption>
    </figure>
    <div class="portrait-caption"><span>ROOTED IN NIGERIA.</span><span>BUILDING EVERYWHERE.</span></div>
  </div>
</section>
<div class="container journey-strip" aria-label="My journey: Lagos to Ottawa to San Francisco">
  <span class="eyebrow">THE JOURNEY SO FAR</span>
  <div class="journey-stops"><span><i class="nigeria-flag" aria-hidden="true"></i>Lagos</span><Arrow /><span>Ottawa</span><Arrow /><span>San Francisco <i class="status-dot" aria-hidden="true"></i></span></div>
</div>
